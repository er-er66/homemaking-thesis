<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.homemaking.mapper.HomemakingPackageMapper">
    <insert id="insert">
        insert into homemaking_package(package_name,service_type,package_price,package_desc,package_img,unit_text,status,sort,expire_status,expire_start_time,expire_end_time,create_time,update_time,is_deleted)
        values(#{packageName},#{serviceType},#{packagePrice},#{packageDesc},#{packageImg},#{unitText},#{status},#{sort},#{expireStatus},#{expireStartTime},#{expireEndTime},#{createTime},#{updateTime},#{isDeleted})
    </insert>
    <update id="updateById">
        update homemaking_package
        set package_name=#{packageName},service_type=#{serviceType},package_price=#{packagePrice},package_desc=#{packageDesc},package_img=#{packageImg},unit_text=#{unitText},status=#{status},sort=#{sort},expire_status=#{expireStatus},expire_start_time=#{expireStartTime},expire_end_time=#{expireEndTime},update_time=#{updateTime}
        where id=#{id}
    </update>

    <!--
        上下架切换用一条 SQL 原子翻转：
        若改成「先 select status 再 update」，并发下两次点击会互相覆盖，结果不可预期。
        is_deleted = 0 保证已删除的套餐不能被重新上架。
    -->
    <update id="toggleStatus">
        update homemaking_package
        set status = case when status = 1 then 0 else 1 end,
            update_time = now()
        where id = #{id} and is_deleted = 0
    </update>

    <!-- 显式设置状态（幂等，便于后续做批量上下架） -->
    <update id="updateStatus">
        update homemaking_package
        set status = #{status},
            update_time = now()
        where id = #{id} and is_deleted = 0
    </update>

    <select id="selectById" resultType="com.example.homemaking.entity.HomemakingPackage">
        select * from homemaking_package where id=#{id}
    </select>
    <select id="selectByIds" resultType="com.example.homemaking.entity.HomemakingPackage">
        select * from homemaking_package
        where is_deleted = 0
        and id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        order by id asc
    </select>
    <select id="selectList" resultType="com.example.homemaking.entity.HomemakingPackage">
        select * from homemaking_package where is_deleted=0
        ORDER BY id ASC
    </select>

    <!-- 套餐列表公共过滤条件：serviceType 为 null/0 视为「全部」，不参与过滤 -->
    <sql id="listCondition">
        <where>
            is_deleted = 0
            <if test="serviceType != null and serviceType != 0">and service_type = #{serviceType}</if>
            <if test="status != null">and status = #{status}</if>
            <if test="packageName != null and packageName != ''">and package_name like concat('%', #{packageName}, '%')</if>
        </where>
    </sql>

    <select id="countByCondition" resultType="long">
        select count(*) from homemaking_package
        <include refid="listCondition"/>
    </select>

    <!--
        ORDER BY id ASC 必须保留：
        前端 packagePager 的 clientSort 只在本地分页模式生效，一旦后端开始分页就失效，
        排序权交给后端。不写排序（或排序不唯一）会导致翻页出现重复/漏数据。
    -->
    <select id="selectPage" resultType="com.example.homemaking.entity.HomemakingPackage">
        select * from homemaking_package
        <include refid="listCondition"/>
        order by id asc
        limit #{offset}, #{pageSize}
    </select>
</mapper>
