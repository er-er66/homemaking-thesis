<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.homemaking.mapper.AdminMapper">
    <select id="getAdminById" resultType="com.example.homemaking.entity.SysAdmin">
        select * from sys_admin where id = #{id}
    </select>

    <!-- 管理员列表公共过滤条件（供 searchAdmins / countAdmins / searchAdminsPage 复用） -->
    <sql id="adminCondition">
        <if test="name != null and name != ''">
            and username like concat('%', #{name}, '%')
        </if>
        <if test="phone != null and phone != ''">
            and phone like concat('%', #{phone}, '%')
        </if>
        <if test="startTime != null">
            and create_time &gt;= #{startTime}
        </if>
        <if test="endTime != null">
            and create_time &lt;= #{endTime}
        </if>
    </sql>

    <select id="searchAdmins" resultType="com.example.homemaking.entity.SysAdmin">
        select * from sys_admin where 1=1
        <include refid="adminCondition"/>
        order by id desc
    </select>

    <select id="countAdmins" resultType="long">
        select count(*) from sys_admin where 1=1
        <include refid="adminCondition"/>
    </select>

    <select id="searchAdminsPage" resultType="com.example.homemaking.entity.SysAdmin">
        select * from sys_admin where 1=1
        <include refid="adminCondition"/>
        order by id desc
        limit #{offset}, #{pageSize}
    </select>
    <select id="selectCountByPhone" resultType="java.lang.Integer">
        select count(*) from sys_admin where phone = #{phone}
    </select>

    <update id="toggleAdminStatus">
        update sys_admin
        set status = case when status = 1 then 0 else 1 end
        where id = #{id}
    </update>
    <update id="updatePassword">
        update sys_admin
        set password = #{newPassword}
        where phone = #{phone}
    </update>
    <update id="changeName">
        update sys_admin
        set username = #{newName}
        where account = #{account}
    </update>
</mapper>