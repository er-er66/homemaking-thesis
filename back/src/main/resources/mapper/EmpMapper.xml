<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.homemaking.mapper.EmpMapper">
    <update id="setEmpStatus">
        update sys_staff
        set status = case when status = 1 then 0 else 1 end
        where id = #{id}
    </update>
    <update id="updatePassword">
        update sys_staff
        set password = #{newPassword}
        where phone = #{phone}
    </update>

    <select id="getAllEmp" resultType="com.example.homemaking.entity.SysStaff">
        select * from sys_staff
    </select>
    <select id="getEmpById" resultType="com.example.homemaking.entity.SysStaff">
        select * from sys_staff where id = #{id}
    </select>
    <!-- 员工列表公共过滤条件（供 searchEmps / countEmps / searchEmpsPage 复用） -->
    <sql id="empCondition">
        <if test="name != null and name != ''">
            and username like concat('%', #{name}, '%')
        </if>
        <if test="phone != null and phone != ''">
            and phone like concat('%', #{phone}, '%')
        </if>
        <if test="startTime != null">
            and create_time &gt;= #{startTime}
        </if>
        <if test="endTime != null">
            and create_time &lt;= #{endTime}
        </if>
    </sql>

    <select id="searchEmps" resultType="com.example.homemaking.entity.SysStaff">
        select * from sys_staff where 1=1
        <include refid="empCondition"/>
        order by id desc
    </select>

    <select id="countEmps" resultType="long">
        select count(*) from sys_staff where 1=1
        <include refid="empCondition"/>
    </select>

    <select id="searchEmpsPage" resultType="com.example.homemaking.entity.SysStaff">
        select * from sys_staff where 1=1
        <include refid="empCondition"/>
        order by id desc
        limit #{offset}, #{pageSize}
    </select>
    <select id="selectCountByPhone" resultType="java.lang.Integer">
        select count(*) from sys_staff where phone = #{phone}
    </select>
</mapper>